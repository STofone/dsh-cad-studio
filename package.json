{
  "name": "dsh-cad-studio",
  "version": "0.30.0",
  "type": "module",
  "description": "CAD Studio — FreeCAD 桥（给 AI 的 14 个工具）+ Web 右栏 3D 面板：建模/装配/关节运动/出图/多页签查看",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/*",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cad",
    "freecad",
    "step",
    "3d",
    "viewer",
    "assembly"
  ],
  "homepage": "https://github.com/STofone/dsh-cad-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STofone/dsh-cad-studio.git"
  },
  "bugs": {
    "url": "https://github.com/STofone/dsh-cad-studio/issues"
  },
  "author": {
    "name": "stofone"
  },
  "license": "MIT"
}
